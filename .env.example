# Discord channel webhook - baked into the client at build time.
# Create via: Discord → Channel Settings → Integrations → Webhooks
VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Analytics - see docs/analytics.md and docs/analytics-setup.md
# Tomorrow: set VITE_ANALYTICS_VENDORS=posthog to keep only one tool.
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_VENDORS=posthog,mixpanel,amplitude
VITE_ANALYTICS_REPLAY_VENDORS=posthog,mixpanel,amplitude
VITE_ANALYTICS_REPLAY_SAMPLE=0.2
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_MIXPANEL_TOKEN=
VITE_AMPLITUDE_API_KEY=
